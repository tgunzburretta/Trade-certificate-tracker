generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for local dev. Point DATABASE_URL at Postgres (e.g. Supabase/Vercel
  // Postgres/Neon) in production — see README "Going to production".
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma, so enum-like fields below are
// plain strings. The allowed values are validated in app code — see
// src/lib/constants.ts (PLAN_STATUSES, ROLES, CERT_TYPES, REMINDER_WINDOWS).

model Company {
  id             String     @id @default(cuid())
  name           String
  // Used to build the public compliance-card URL: /c/[shareSlug]
  shareSlug      String     @unique
  planStatus     String     @default("TRIAL")
  // One of PLAN_TIERS in src/lib/constants.ts (SOLO/CREW/BUSINESS) — caps
  // how many workers the company can add. See getWorkerLimit().
  planTier       String     @default("CREW")
  trialEndsAt    DateTime
  stripeCustomerId       String? @unique
  stripeSubscriptionId   String? @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  users        User[]
  workers      Worker[]
  certificates Certificate[]
  cardViews    CardView[]
}

// One page load of a company's public compliance card — a raw pageview
// count, not deduped by visitor. Surfaced back to the company as "X views
// this month" so the free, no-login compliance card visibly earns its
// keep as part of the paid plan, instead of being invisible to them.
model CardView {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@index([companyId, viewedAt])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  role            String    @default("OWNER")
  emailVerifiedAt DateTime?
  // One of REFERRAL_SOURCES in src/lib/constants.ts — how the registrant
  // said they heard about Vetted. Optional, captured at signup only.
  referralSource  String?
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
}

model Worker {
  id        String   @id @default(cuid())
  name      String
  jobTitle  String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  certificates Certificate[]

  @@index([companyId])
}

model Certificate {
  id           String    @id @default(cuid())
  type         String
  label        String
  issuedDate   DateTime?
  expiryDate   DateTime
  // Relative path within the private storage root (see src/lib/storage.ts) —
  // not a public URL. Documents are served through the authenticated
  // /api/documents/[certId] route, never directly.
  documentPath String?
  documentName String?
  notes        String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  workerId String?
  worker   Worker? @relation(fields: [workerId], references: [id], onDelete: Cascade)

  reminders ReminderLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([workerId])
  @@index([expiryDate])
}

// A paying main-contractor account — separate from Company/User, which model
// the trade businesses being tracked. A Contractor doesn't have workers or
// certificates of their own; they subscribe to watch OTHER companies'
// public compliance cards from one dashboard. See src/lib/contractorAuth.ts.
model Contractor {
  id              String    @id @default(cuid())
  businessName    String
  email           String    @unique
  passwordHash    String
  planStatus      String    @default("TRIAL")
  emailVerifiedAt DateTime?
  // One of REFERRAL_SOURCES in src/lib/constants.ts.
  referralSource  String?
  trialEndsAt     DateTime
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  createdAt    DateTime @default(now())

  watchedSubs WatchedSub[]
}

// One subcontractor a Contractor has added to their watchlist, identified by
// the subcontractor's compliance-card shareSlug (Company.shareSlug). Not a
// foreign key to Company: the sub may paste a link before or independent of
// whichever company record it resolves to, and an unresolvable slug should
// still show up as "not found" rather than fail to save.
model WatchedSub {
  id           String   @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  label        String
  shareSlug    String
  createdAt    DateTime @default(now())

  @@unique([contractorId, shareSlug])
  @@index([contractorId])
}

// Single-use tokens for email verification and password reset, for both
// account types. Only a SHA-256 hash of the token is stored — the raw token
// exists only in the emailed link, so a DB read alone can't be replayed as
// a working link (same reasoning as password hashing). See src/lib/tokens.ts.
model VerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  // One of: EMAIL_VERIFY_USER, EMAIL_VERIFY_CONTRACTOR,
  // PASSWORD_RESET_USER, PASSWORD_RESET_CONTRACTOR (src/lib/tokens.ts)
  purpose   String
  // A User.id or Contractor.id depending on purpose — not a foreign key
  // since it points at one of two different tables.
  subjectId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([subjectId])
}

model ReminderLog {
  id            String      @id @default(cuid())
  certificateId String
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  window        String
  sentAt        DateTime    @default(now())

  // Prevents the same cert from getting the same reminder window twice.
  @@unique([certificateId, window])
}
