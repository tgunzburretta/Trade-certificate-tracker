DATABASE_URL="file:./dev.db"
# At least 32 random characters — generate one with `openssl rand -hex 32`.
AUTH_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"

# Optional: real email delivery for renewal reminders, verification emails
# and password resets (https://resend.com). Without it, these are logged to
# the console instead — handy for local dev/demos, but verification and
# password-reset links only actually work if you can read the console log.
RESEND_API_KEY=""
REMINDER_FROM_EMAIL="alerts@yourdomain.com"

# Shared secret the daily reminder cron job must send
CRON_SECRET="replace-with-a-long-random-string"

# Optional: Upstash Redis (https://upstash.com), REST-based so it works from
# serverless/edge. Enables login rate limiting shared across instances —
# without it, rate limiting falls back to a per-instance in-memory counter,
# which is fine for a single Node process but not for multiple
# replicas/serverless (each gets its own counter).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: Stripe billing. Leave blank to use the built-in fake checkout
# flow (useful for demos and for the "free for testimonial" first 10 deals).
STRIPE_SECRET_KEY=""
# One Stripe Price per trade-company plan tier (see PLAN_TIERS in
# src/lib/constants.ts) — all three must be set to enable real Stripe billing
# for trade companies.
STRIPE_PRICE_ID_SOLO=""
STRIPE_PRICE_ID_CREW=""
STRIPE_PRICE_ID_BUSINESS=""
# Stripe Price for the contractor plan (src/app/for-contractors).
STRIPE_PRICE_ID_CONTRACTOR=""
STRIPE_WEBHOOK_SECRET=""
