DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"

# Optional: real email delivery for renewal reminders (https://resend.com)
RESEND_API_KEY=""
REMINDER_FROM_EMAIL="alerts@yourdomain.com"

# Shared secret the daily reminder cron job must send
CRON_SECRET="replace-with-a-long-random-string"

# Optional: Stripe billing. Leave blank to use the built-in fake checkout
# flow (useful for demos and for the "free for testimonial" first 10 deals).
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
